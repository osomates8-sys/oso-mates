# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.

# --- Claude (https://console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=
# Opcionales:
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low = más rápido y barato, high = piensa más

# --- WhatsApp (Meta for Developers -> tu app -> WhatsApp) ---
# Token permanente de un "usuario del sistema" con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# Una clave que inventás vos y pegás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app -> Básica -> Clave secreta de la app
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0

# --- Mercado Pago (opcional, uno por negocio) ---
# El nombre de cada variable lo define clientes/<negocio>.json -> pagos.mercadopago.access_token_env
MP_ACCESS_TOKEN_OSO_MATES=

# --- Audios (solo planes con "audios": true en planes.json) ---
# Clave del servicio de transcripción. Por defecto OpenAI Whisper:
TRANSCRIPCION_API_KEY=
# Para usar Groq (más barato), además:
# TRANSCRIPCION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIPCION_MODELO=whisper-large-v3

# --- Número de demostración (comando #demo) ---
# Phone number ID del número que usás para demos (por ejemplo, el número de prueba de Meta)
DEMO_PHONE_NUMBER_ID=
# Tu WhatsApp: el único que puede mandar #demo, #demos y #fin
ADMIN_WHATSAPP=
# DEMO_DIAS=7                    # cuánto dura cada demo
# DEMO_FICHA_POR_DEFECTO=        # ficha para quien escribe sin demo asignada (vacío = mensaje de presentación)
# DEMO_TOKEN_ENV=WHATSAPP_TOKEN  # variable con el token de ese número, si es de otra cuenta

# --- Panel de negocios (para vos) ---
# Clave para entrar a https://TU-SERVIDOR/admin?clave=...  (sin clave, el panel está apagado)
ADMIN_CLAVE=
# Plantilla de Meta para avisar al dueño fuera de las 24 h (se crea con: npm run plantilla -- <negocio>)
# PLANTILLA_AVISO=aviso_dueno
# PLANTILLA_IDIOMA=es_AR
# INFORMES_AUTOMATICOS=0   # para no mandar el informe mensual automático (plan Temporada)

# --- Ajustes (opcionales) ---
# PORT=3000
# HORAS_SESION=12          # horas sin mensajes para que la charla arranque de cero
# HORAS_PAUSA_HUMANO=12    # horas que el bot se calla después de derivar a una persona
# ESPERA_MS=3000           # espera para juntar mensajes seguidos antes de responder
# DIR_DATOS=./data
