# Copiá este archivo como .env y completá los valores. Nunca subas el .env al repositorio.

# --- Claude (https://console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=
# Opcionales:
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low = más rápido y barato, high = piensa más

# --- WhatsApp (Meta for Developers -> tu app -> WhatsApp) ---
# Token permanente de un "usuario del sistema" con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# Una clave que inventás vos y pegás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app -> Básica -> Clave secreta de la app
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0

# --- Mercado Pago (opcional, uno por negocio) ---
# El nombre de cada variable lo define clientes/<negocio>.json -> pagos.mercadopago.access_token_env
MP_ACCESS_TOKEN_OSO_MATES=

# --- Ajustes (opcionales) ---
# PORT=3000
# HORAS_SESION=12          # horas sin mensajes para que la charla arranque de cero
# HORAS_PAUSA_HUMANO=12    # horas que el bot se calla después de derivar a una persona
# ESPERA_MS=3000           # espera para juntar mensajes seguidos antes de responder
# DIR_DATOS=./data
