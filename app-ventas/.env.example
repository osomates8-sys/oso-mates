# Copiá este archivo como .env.local y completá los valores.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# RevenueCat → Project → API keys (claves públicas de cada tienda)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Dirección donde publicaste catalogo-web/ (ver README). Ej: https://tutienda.netlify.app/
EXPO_PUBLIC_CATALOG_URL=
